FROM schemers/all-r7rs:head
RUN apt-get update && apt-get install -y \
    bats make libffi-dev parallel time git ca-certificates
RUN git clone https://github.com/Retropikzel/chibi-scheme.git --depth=1 --branch=install-dependencies-when-installing-from-file
RUN make -C chibi-scheme && make -C chibi-scheme install
RUN mkdir -p "${HOME}/.snow/" && echo "()" > "${HOME}/.snow/config.scm"
RUN snow-chibi --impls=chibi install retropikzel.compile-r7rs
